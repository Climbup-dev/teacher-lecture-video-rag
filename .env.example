# =================================================================
# ClimbUp Mentor Engine - Environment Configuration Template
# Duplicate this file to .env and supply your credentials.
# =================================================================

# Server & Environment
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
ADMIN_API_KEY=your_secure_admin_api_key_here
READONLY_CONFIG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,https://teacher-lecture-video-rag-28929614461.asia-south1.run.app

# Speech-to-Text: Deepgram Nova-2 API Key
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# AI & LLM: Google Gemini API (gemini-2.5-flash / gemini-embedding-001)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database & Vector Store: Supabase (PostgreSQL + pgvector)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Storage & Google Drive Integration
GOOGLE_DRIVE_FOLDER_ID=1VDrNYA5GE6l9h21D2Co0HuuuD87Ain6d
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=your_oauth_refresh_token
GOOGLE_CREDENTIALS_JSON=

# Resource and Media Limits
MAX_UPLOAD_SIZE_MB=500
MAX_RESOURCE_SIZE_MB=50

# Agora Interactive Live Streaming
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
